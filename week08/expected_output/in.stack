# in.stack — week08 3층 계면 셀 · 석영(ClayFF) | 물(SPC/E) | 톨루엔(GAFF2) · COMID clayff_gaff2_v1 설정
units          real
atom_style     full
boundary       p p f
pair_style     lj/cut/coul/long 12.0
bond_style     harmonic
angle_style    harmonic
dihedral_style fourier
special_bonds  lj 0.0 0.0 0.5 coul 0.0 0.0 0.833333
read_data      stack.data

pair_modify    mix arithmetic
kspace_style   pppm 1.0e-4
kspace_modify  slab 3.0
neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

group          slab id 1:540
group          water id 541:1167
group          binder id 1168:1467
group          mobile subtract all slab

fix            frz slab setforce 0.0 0.0 0.0
compute        tm mobile temp
compute        zb binder reduce ave z
compute        zw water reduce ave z
thermo_style   custom step c_tm pe evdwl ecoul elong c_zw c_zb
thermo         50
minimize       1.0e-4 1.0e-6 2000 20000
reset_timestep 0
fix            shk water shake 1.0e-4 20 0 b 1 a 1
velocity       mobile create 298.0 4928459 mom yes rot yes dist gaussian
fix            nvt mobile nvt temp 298.0 298.0 100.0
fix_modify     nvt temp tm
timestep       1.0
dump           d1 all custom 500 stack_last.dump id mol type q x y z
run            500
write_data     stack_final.data
