# in.protocol — MD 워크플로우 ④ 표준 프로토콜 (GAFF2 · real 단위)
# 변수(runner.py 가 -var 로 넘김): data seed dt T Thot Phi stepsA stepsB stepsC stepsD stepsE stepsP every(좌표 저장 간격)
# 최소화 → A 고온 섞기(NVT Thot) → B 고온 압축(NPT Thot · Phi atm) → C 고온 이완(NPT Thot · 1 atm)
#        → D 냉각(NPT Thot→T) → E 평형(NPT T) → P 생산(NPT T · 밀도 기록 · 좌표 저장 = CED 용)
units          real
atom_style     full
boundary       p p p
pair_style     lj/cut/coul/long 12.0
bond_style     harmonic
angle_style    harmonic
dihedral_style fourier
improper_style cvff
special_bonds  amber
read_data      ${data}
pair_modify    mix arithmetic tail yes
kspace_style   pppm 1.0e-4
neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes
timestep       ${dt}

thermo_style   custom step temp press density pe ke etotal vol
thermo_modify  flush yes
thermo         1000
minimize       1.0e-4 1.0e-6 2000 20000
reset_timestep 0

velocity       all create ${Thot} ${seed} mom yes rot yes dist gaussian
fix            A all nvt temp ${Thot} ${Thot} 100.0
run            ${stepsA}
unfix          A
fix            B all npt temp ${Thot} ${Thot} 100.0 iso ${Phi} ${Phi} 1000.0
run            ${stepsB}
unfix          B
fix            C all npt temp ${Thot} ${Thot} 100.0 iso 1.0 1.0 1000.0
run            ${stepsC}
unfix          C
fix            D all npt temp ${Thot} ${T} 100.0 iso 1.0 1.0 1000.0
run            ${stepsD}
unfix          D
fix            E all npt temp ${T} ${T} 100.0 iso 1.0 1.0 1000.0
run            ${stepsE}
unfix          E
write_data     equil.data

# 생산 — 이 구간만 물성에 쓴다 (thermo = 밀도 · 에너지 · 좌표 = CED)
reset_timestep 0
thermo         200
fix            P all npt temp ${T} ${T} 100.0 iso 1.0 1.0 1000.0
dump           F all custom ${every} prod.lammpstrj id mol type q xu yu zu
dump_modify    F sort id
run            ${stepsP}
write_data     final.data
